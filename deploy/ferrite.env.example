# Private instance (native install): copy the values into /var/www/ferrite/.env
APP_NAME=Ferrite
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate
APP_URL=https://ferrite.stackcare.pt
DB_CONNECTION=sqlite
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database
LOG_LEVEL=warning
FERRITE_LANDING=true
FERRITE_DEMO_URL=https://demo.ferrite.stackcare.pt
FERRITE_REGISTRATION=false
# Only if nginx is on another host/container; nginx on localhost needs nothing:
# TRUSTED_PROXIES=127.0.0.1
