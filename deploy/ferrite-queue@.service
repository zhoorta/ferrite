# systemd template: ferrite-queue@uploads and ferrite-queue@default
[Unit]
Description=Ferrite queue worker (%i)
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/ferrite
Restart=always
RestartSec=2
ExecStart=/usr/bin/php artisan queue:work --queue=%i --tries=1 --timeout=0 --sleep=1 --max-time=3600

[Install]
WantedBy=multi-user.target
