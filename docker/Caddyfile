{
	admin off
	# TLS is the reverse proxy's job; this listens on plain HTTP.
	auto_https off
	frankenphp
}

:8080 {
	root * /app/public

	# Nothing starting with a dot is public, except /.well-known (passkeys).
	@dotfiles {
		path_regexp dot ^/\.
		not path /.well-known/*
	}
	respond @dotfiles 404

	# Built assets have hashed names.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	# No `encode`: compressing would break Range requests and streamed downloads.

	php_server
}
