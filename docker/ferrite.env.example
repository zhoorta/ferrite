# Copy to ferrite.env (next to docker-compose.yml) and edit. Never commit ferrite.env.

# Required. Generate with: docker compose run --rm ferrite php artisan key:generate --show
# Keep a copy somewhere safe: it encrypts two-factor secrets and storage disk credentials,
# so losing it locks people out of 2FA and breaks S3/SFTP disks.
APP_KEY=

# The public address people use, including https://. Used for every link Ferrite generates.
APP_URL=https://files.example.com

# IP addresses (or CIDR ranges, comma-separated) of your reverse proxy, or * for any.
# Needed so Ferrite sees https and the real client IP.
TRUSTED_PROXIES=

# Send the session cookie over https only. Turn on when you serve over https (you should).
SESSION_SECURE_COOKIE=true

# Registration is closed after the first (admin) account. Add users in the admin screen.
# FERRITE_REGISTRATION=false

# How long the trash is kept (days) and how long the activity log is kept (days).
# FERRITE_TRASH_DAYS=30
# FERRITE_ACTIVITY_DAYS=90

# E-mail, for password reset links. Without it, admins can still reset passwords in the
# Users screen or with `php artisan ferrite:user`.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=ferrite@example.com
# MAIL_FROM_NAME=Ferrite

# Use MySQL/MariaDB instead of SQLite (the default, stored in the data volume):
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=ferrite
# DB_USERNAME=ferrite
# DB_PASSWORD=

# Optional. A link to a demo, and demo mode (a public try-out instance with throwaway
# accounts; see docs/public-site.md).
# FERRITE_DEMO_URL=https://demo.example.com
# FERRITE_DEMO=false
