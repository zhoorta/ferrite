APP_NAME=Ferrite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Ferrite ---------------------------------------------------------------
# Registration stays closed once the first (admin) account exists.
FERRITE_REGISTRATION=false
# Days the trash keeps items before they are deleted for good, and the activity log keeps entries.
FERRITE_TRASH_DAYS=30
FERRITE_ACTIVITY_DAYS=90
# Replacing a file keeps its earlier content as versions: how many per file (0: off) and how long (days, 0: no limit).
# They count against the quota (docs/versions.md).
# FERRITE_VERSIONS_KEEP=5
# FERRITE_VERSIONS_DAYS=0
# Search inside text files and PDFs (PDFs need pdftotext, from poppler-utils)
FERRITE_SEARCH_CONTENTS=true
# Nightly integrity scrub: read this many stored blobs back and compare their sha256 (0: off, docs/storage-check.md).
# FERRITE_SCRUB_BLOBS=0
# Encryption at rest for disks set to "Encrypt files" (docs/encryption.md). 32 random bytes, base64:
#   php -r "echo base64_encode(random_bytes(32));"
# BACK IT UP with APP_KEY: without it every encrypted file is lost.
# FERRITE_FILE_KEY=
# Key rotation: the current key's id, and the retired keys ("id:base64,id:base64") until files:rekey has run.
# FERRITE_FILE_KEY_ID=1
# FERRITE_FILE_KEYS_OLD=
# Index the text of files on encrypted disks too (stored unencrypted in the database).
# FERRITE_SEARCH_ENCRYPTED=false
# Upload chunk size in bytes (keep it below your web server's request body limit).
# FERRITE_CHUNK_SIZE=5242880
# Where the default local disk and unfinished uploads live.
# FERRITE_LOCAL_ROOT=
# FERRITE_TMP_PATH=
# Behind a reverse proxy: its IPs, comma-separated, or * (see docs/install.md).
# TRUSTED_PROXIES=
